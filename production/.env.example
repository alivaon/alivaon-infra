# ═══════════════════════════════════════════════════════════════════════════
# Gabarit de /opt/alivaon/production/.env sur le VPS.
#
# Ce fichier ne contient AUCUNE valeur réelle. Le .env véritable n'est
# versionné nulle part : il n'existe que sur le serveur. En cas de perte,
# les valeurs sont à reconstituer (mots de passe de base à réinitialiser,
# APP_SECRET à régénérer, DSN à récupérer auprès du fournisseur d'envoi).
#
# Copier en .env sur le serveur, renseigner, puis :
#   cd /opt/alivaon/production && docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════

# ── Toutes les variables ci-dessous sont consommées PAR LES CONTENEURS ──────
# Elles sont injectées via `env_file:` dans docker-compose.yml. Aucune n'est
# interpolée côté hôte : une variable manquante se traduit par une erreur au
# démarrage de l'application, pas par une dégradation silencieuse.
# (Contrairement au staging — voir staging/.env.example.)

# ── Application Symfony ────────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0
# Régénérer : php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=
# Traefik est le seul proxy en amont. Voir la note sur les en-têtes aliasants
# dans docs/traefik.md.
SYMFONY_TRUSTED_PROXIES=
DEFAULT_URI=https://www.alivaon.com
# Doit pointer sur le service `db` du même compose, pas sur 127.0.0.1.
DATABASE_URL=mysql://UTILISATEUR:MOT_DE_PASSE@db:3306/NOM_DE_BASE?serverVersion=8.0
APP_STAGING=0

# ── Base MySQL (service db) ────────────────────────────────────────────────
# MYSQL_* initialisent le conteneur au PREMIER démarrage uniquement : sur un
# volume déjà peuplé, les modifier ici ne change rien côté serveur MySQL.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Envoi de courriel ──────────────────────────────────────────────────────
MAILER_DSN=
ADMIN_EMAIL=
MESSENGER_TRANSPORT_DSN=

# ── Mesure d'audience ──────────────────────────────────────────────────────
GA_MEASUREMENT_ID=
