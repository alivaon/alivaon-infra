# ═══════════════════════════════════════════════════════════════════════════
# Gabarit de /opt/alivaon/staging/.env sur le VPS.
#
# Ce fichier ne contient AUCUNE valeur réelle. Le .env véritable n'existe que
# sur le serveur et n'est versionné nulle part.
#
# ATTENTION — ce .env a DEUX usages distincts, contrairement à celui de la
# production. Lire la section « INTERPOLÉE CÔTÉ HÔTE » plus bas avant tout
# redéploiement : une variable manquante y provoque une panne SILENCIEUSE.
# ═══════════════════════════════════════════════════════════════════════════


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║  BLOC 1 — VARIABLES INTERPOLÉES CÔTÉ HÔTE PAR DOCKER COMPOSE            ║
# ║                                                                         ║
# ║  Lues par Compose AVANT le démarrage, pour construire les labels du     ║
# ║  conteneur. Elles ne servent pas (seulement) à l'application.           ║
# ║                                                                         ║
# ║  ⚠️  DANGER : Compose remplace une variable absente par une CHAÎNE      ║
# ║      VIDE, sans avertissement ni code d'erreur. La stack démarre,       ║
# ║      les conteneurs sont « healthy », et la protection disparaît.       ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# Hash BasicAuth protégeant tout le préprod, injecté dans le label Traefik
#   traefik.http.middlewares.staging-auth.basicauth.users=${STAGING_BASICAUTH}
#
# SI CETTE VARIABLE EST ABSENTE OU VIDE :
#   le middleware est construit avec une liste d'utilisateurs vide. Le préprod
#   devient PUBLIC et INDEXABLE par les moteurs de recherche. Aucune erreur
#   n'est levée, aucun conteneur ne tombe, rien dans les journaux.
#   Depuis Traefik v3.6.19 un middleware BasicAuth non construit renvoie 404
#   et non plus 401 — le symptôme change donc selon les versions, mais dans
#   tous les cas il n'y a PAS de message d'erreur explicite.
#
# CONTRÔLE APRÈS CHAQUE REDÉPLOIEMENT (voir README, « Pièges connus ») :
#   curl -s -o /dev/null -w '%{http_code}\n' https://www.staging.alivaon.com
#   → doit renvoyer 401. Un 200 signifie que la protection est tombée.
#
# Générer un hash : htpasswd -nbB utilisateur motdepasse
# Format attendu : utilisateur:$2y$05$...
# Note : dans un fichier .env lu par Compose, les $ n'ont PAS à être doublés.
STAGING_BASICAUTH=


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║  BLOC 2 — VARIABLES CONSOMMÉES PAR LES CONTENEURS                      ║
# ║                                                                         ║
# ║  Injectées via `env_file:`. Une variable manquante ici provoque une     ║
# ║  erreur visible au démarrage de l'application, pas une dégradation      ║
# ║  silencieuse.                                                           ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# ── Application Symfony ────────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0
# Régénérer : php -r 'echo bin2hex(random_bytes(16));'
# Doit être DIFFÉRENT de celui de la production.
APP_SECRET=
SYMFONY_TRUSTED_PROXIES=
DEFAULT_URI=https://www.staging.alivaon.com
DATABASE_URL=mysql://UTILISATEUR:MOT_DE_PASSE@db:3306/NOM_DE_BASE?serverVersion=8.0
APP_STAGING=1

# ── Base MySQL (service db, volume distinct de la production) ──────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Envoi de courriel ──────────────────────────────────────────────────────
MAILER_DSN=
ADMIN_EMAIL=
MESSENGER_TRANSPORT_DSN=

# ── Mesure d'audience ──────────────────────────────────────────────────────
GA_MEASUREMENT_ID=

# ── Front Next.js (docs/next.md) ───────────────────────────────────────────
# Régénération des pages du front après chaque modification de contenu.
# NEXT_REVALIDATE_SECRET a les DEUX usages de ce fichier : lu par Symfony
# (env_file) ET interpolé dans le service web (environment:). Absent ou vide :
# le front refuse toutes les demandes (401) — pas de faille, mais les pages ne
# se régénèrent qu'à l'expiration de leur cache.
# Générer : php -r 'echo bin2hex(random_bytes(32));'
NEXT_REVALIDATE_URL=http://web:3000/api/revalidate
NEXT_REVALIDATE_SECRET=
