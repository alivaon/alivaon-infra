# ═══════════════════════════════════════════════════════════════════════════
# Gabarit de /etc/alivaon-backup/backup.env sur le VPS.
#
# Ce fichier ne contient AUCUNE valeur secrète. Le fichier réel n'existe que
# sur le serveur, en root:root 0600 : les scripts refusent de démarrer si un
# autre utilisateur peut le lire ou le modifier (il est sourcé par bash, en
# root).
#
# Syntaxe bash : pas d'espace autour du =, valeurs contenant des espaces ou
# des caractères spéciaux entre apostrophes simples.
#
# Les noms de conteneurs et de volumes, l'UID:GID de l'application et
# l'absence d'exclusion ci-dessous sont les valeurs CONSTATÉES sur le serveur
# le 2026-09-23 (RUNBOOK-BACKUP.md, « Topologie constatée » ; détail dans
# docs/journal-installation-sauvegarde.md). L'étape 2 du runbook, rejouée,
# confirme qu'elles n'ont pas changé.
# ═══════════════════════════════════════════════════════════════════════════


# ── Dépôt restic ────────────────────────────────────────────────────────────
#
# Un seul dépôt pour les deux environnements. Chacun y a ses propres
# instantanés, étiquetés env:production ou env:staging, dont les chemins ne se
# recouvrent pas. restore.sh s'appuie sur cette étiquette pour refuser de
# restaurer l'un à la place de l'autre.
#
# Option A — Hetzner Storage Box, en SFTP (recommandée) :
#   « alivaon-storagebox » est l'alias défini dans
#   /etc/ssh/ssh_config.d/alivaon-backup.conf (hôte, port 23, utilisateur,
#   clé, known_hosts : voir RUNBOOK-BACKUP.md, étape 6). Chemin relatif au
#   dossier du compte de la Storage Box.
RESTIC_REPOSITORY=sftp:alivaon-storagebox:restic-alivaon
#
# Option B — stockage objet compatible S3 (Hetzner Object Storage, etc.) :
#   RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/NOM_DU_BUCKET/restic-alivaon
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   Le bucket doit être PRIVÉ. Clés d'accès limitées à ce seul bucket.

# Fichier contenant le mot de passe du dépôt (root:root 0600, droits posés par
# install.sh).
#
# ╔═════════════════════════════════════════════════════════════════════════╗
# ║  POINT DE DÉFAILLANCE UNIQUE DU DISPOSITIF                              ║
# ║                                                                         ║
# ║  Ce mot de passe chiffre TOUT le dépôt. Il n'existe aucun moyen de le   ║
# ║  retrouver ni de le contourner : ni Hetzner, ni restic ne le peuvent.   ║
# ║                                                                         ║
# ║  Le fichier ci-dessous vit sur le VPS. Si le VPS est perdu, il est      ║
# ║  perdu avec lui. La RÉFÉRENCE est donc la copie du gestionnaire de      ║
# ║  mots de passe : le dépôt est initialisé depuis le Mac avec elle, et    ║
# ║  le test 0 prouve qu'elle l'ouvre, AVANT toute installation sur le VPS. ║
# ║  Sans elle, les sauvegardes existent mais sont illisibles à jamais.     ║
# ╚═════════════════════════════════════════════════════════════════════════╝
RESTIC_PASSWORD_FILE=/etc/alivaon-backup/restic-password

# Nom d'hôte inscrit dans les instantanés. FIXE, et non le hostname réel :
# un VPS reconstruit portera un autre nom, et la rétention (groupée par hôte)
# ne doit pas repartir de zéro. Ne pas modifier après la première sauvegarde.
RESTIC_HOST=alivaon-vps

# Cache local de restic (index, métadonnées). Facultatif : la valeur par
# défaut est celle des unités systemd (CacheDirectory=alivaon-backup).
# RESTIC_CACHE_DIR=/var/cache/alivaon-backup


# ── Environnements sauvegardés ──────────────────────────────────────────────
#
# Traités dans cet ordre. Seules valeurs admises : production, staging.
BACKUP_ENVIRONMENTS='production staging'


# ── Production ──────────────────────────────────────────────────────────────
#
# Conteneur MySQL. Constaté le 2026-09-23 (docker ps).
PRODUCTION_DB_CONTAINER=production-db-1
# Base. Constatée le 2026-09-23.
PRODUCTION_DB_NAME=alivaon_db

# Utilisateur de SAUVEGARDE, dédié, créé à l'étape 3 du runbook en
# 'backup'@'localhost' : mysqldump s'exécute dans le conteneur MySQL et s'y
# connecte par socket Unix (protocol=socket), que MySQL évalue comme
# 'localhost'. Privilèges : SELECT, SHOW VIEW, TRIGGER sur alivaon_db, et rien
# d'autre (escalade éventuelle : étape 3.3). La sauvegarde ne dépend pas des
# privilèges de l'application.
PRODUCTION_BACKUP_DB_USER=backup
# Source : gestionnaire de mots de passe, entrée « MySQL backup — production »,
# généré à l'étape 3 (openssl rand -hex 24). Différent de celui du staging.
# Transmis au conteneur par l'entrée standard, jamais en argument (ps).
PRODUCTION_BACKUP_DB_PASSWORD=

# Utilisateur APPLICATIF, utilisé uniquement par restore.sh : restaurer
# suppose de supprimer et recréer la base, ce que l'utilisateur backup ne
# peut pas faire (et ne doit pas pouvoir faire). Source : MYSQL_USER de
# /opt/alivaon/production/.env.
PRODUCTION_DB_USER=alivaon_app
# Source : MYSQL_PASSWORD de /opt/alivaon/production/.env, recopié tel quel.
# S'il change un jour côté MySQL, le changer ICI aussi, sinon la restauration
# échouera au moment où on en aura besoin (verify.sh ne le teste pas).
PRODUCTION_DB_PASSWORD=

# Conteneur applicatif, arrêté pendant une restauration. Constaté le
# 2026-09-23 (docker ps).
PRODUCTION_APP_CONTAINER=production-app-1

# UID:GID numériques sous lesquels l'application (PHP-FPM) écrit dans les
# volumes, et auxquels la racine de chaque volume doit appartenir. restore.sh
# refuse de restaurer un instantané dont les volumes appartiennent à un autre
# UID, puis vérifie propriétaire et droits après écriture : sans cela, une
# restauration paraît réussie et le premier téléversement échoue plus tard.
# Constaté le 2026-09-23 : workers PHP-FPM « pool www » en 82:82,
# racine des volumes en 82:82, aucun fichier sous un autre UID.
PRODUCTION_APP_OWNER=82:82

# Volumes de fichiers, sous la forme rôle=nom_du_volume_docker, séparés par
# des espaces. Le chemin sur disque n'est jamais écrit ici : il est demandé à
# Docker (docker volume inspect) à chaque exécution, et le volume doit utiliser
# le pilote « local », vérifié à chaque exécution.
#   uploads    -> /var/www/html/public/uploads  (VichUploader)
#   cv_private -> /var/www/html/var/private     (CV des candidats, hors docroot)
# Constatés le 2026-09-23, pilote local (docker volume inspect).
# Le rôle sert à apparier les volumes lors d'une restauration : il doit être
# identique d'un environnement à l'autre.
PRODUCTION_VOLUMES='uploads=production_uploads cv_private=production_cv_private'


# ── Staging ─────────────────────────────────────────────────────────────────
#
# Mêmes rôles et mêmes règles que la production ; seules les sources changent.

# Constaté le 2026-09-23 (docker ps).
STAGING_DB_CONTAINER=staging-db-1
# Constatée le 2026-09-23 : même nom qu'en production.
STAGING_DB_NAME=alivaon_db
# 'backup'@'localhost' du serveur MySQL du staging, créé à l'étape 3.2.
STAGING_BACKUP_DB_USER=backup
# Source : gestionnaire, entrée « MySQL backup — staging » (étape 3.2).
STAGING_BACKUP_DB_PASSWORD=
# Source : MYSQL_USER de /opt/alivaon/staging/.env. Restauration seulement.
STAGING_DB_USER=alivaon_app
# Source : MYSQL_PASSWORD de /opt/alivaon/staging/.env.
STAGING_DB_PASSWORD=
# Constaté le 2026-09-23 (docker ps).
STAGING_APP_CONTAINER=staging-app-1
# Constaté le 2026-09-23, identique à la production.
STAGING_APP_OWNER=82:82
# Constatés le 2026-09-23, pilote local. Le suffixe « _staging » est doublé
# dans les deux noms : projet « staging » + volume « uploads_staging » ou
# « cv_private_staging ».
STAGING_VOLUMES='uploads=staging_uploads_staging cv_private=staging_cv_private_staging'


# ── Rétention ───────────────────────────────────────────────────────────────
#
# Choix d'exploitation, pour la reprise après incident : une sauvegarde n'est
# pas une archive. Appliquée séparément à chaque environnement, à toutes les
# données (base et fichiers), puis `restic forget --prune`. Ordre de grandeur :
# ~17 instantanés conservés par environnement, soit six mois d'historique.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6


# ── Restauration ────────────────────────────────────────────────────────────
#
# Marge de sécurité, en pourcentage, exigée par restore.sh sur l'espace disque
# libre. Le besoin est estimé depuis l'instantané (fichiers des volumes et dump
# SQL) : une fois dans le dossier de travail (/var/lib/alivaon-backup/restore/,
# extraction restic), une fois dans les volumes (rsync) ; sur un même système
# de fichiers, soit environ deux fois les données. Refus chiffré si l'espace
# libre est inférieur à besoin × (100 + marge) / 100. Entier ≥ 0.
# Source : choix d'exploitation. Défaut : 20.
RESTORE_SPACE_MARGIN_PERCENT=20


# ── Surveillance ────────────────────────────────────────────────────────────
#
# Âge maximal toléré du dernier instantané, contrôlé par verify.sh (lancé
# chaque dimanche par alivaon-backup-verify.timer, avec relecture tournante de
# 1/8 des données). Choix d'exploitation : deux nuits de sauvegarde.
MAX_AGE_HOURS=48

# Dead man's switch (healthchecks.io ou instance auto-hébergée compatible).
# URL de ping du check, sans suffixe, par exemple :
#   https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Reçoit /start au début, /0 en cas de succès, /<code> ou /fail en cas
# d'échec (y compris l'échec du contrôle hebdomadaire verify). Le service
# alerte aussi si AUCUN ping n'arrive dans le délai : c'est le seul moyen de
# détecter une sauvegarde qui ne s'exécute plus.
# Source : healthchecks.io, créé à l'étape 10 du runbook ; copie dans le
# gestionnaire. VIDE = désactivé (le journal systemd reste alimenté).
HC_PING_URL=


# ── Exclusions (facultatif) ─────────────────────────────────────────────────
#
# Fichier de motifs restic (--exclude-file), un motif par ligne. VIDE, et
# c'est voulu : constaté le 2026-09-23, le cache LiipImagine est dans
# public/media/cache, dans la couche du conteneur applicatif, et NON dans un
# volume. Il n'y a donc rien de régénérable à exclure de la sauvegarde. À ne
# renseigner que si un cache venait un jour à être placé dans un volume.
RESTIC_EXCLUDE_FILE=
