# ═══════════════════════════════════════════════════════════════════════════
# Gabarit de /etc/alivaon-backup/backup.env sur le VPS.
#
# Ce fichier ne contient AUCUNE valeur secrète. Le fichier réel n'existe que
# sur le serveur, en root:root 0600 : les scripts refusent de démarrer si un
# autre utilisateur peut le lire ou le modifier (il est sourcé par bash, en
# root).
#
# Syntaxe bash : pas d'espace autour du =, valeurs contenant des espaces ou
# des caractères spéciaux entre apostrophes simples.
#
# Les noms de conteneurs et de volumes ci-dessous sont DÉDUITS des fichiers
# compose du dépôt, non constatés sur le serveur. Les vérifier avant la
# première exécution : RUNBOOK-BACKUP.md, section « Hypothèses ».
# ═══════════════════════════════════════════════════════════════════════════


# ── Dépôt restic ────────────────────────────────────────────────────────────
#
# Un seul dépôt pour les deux environnements. Chacun y a ses propres
# instantanés, étiquetés env:production ou env:staging, dont les chemins ne se
# recouvrent pas. restore.sh s'appuie sur cette étiquette pour refuser de
# restaurer l'un à la place de l'autre.
#
# Option A — Hetzner Storage Box, en SFTP (recommandée) :
#   « alivaon-storagebox » est l'alias défini dans
#   /etc/ssh/ssh_config.d/alivaon-backup.conf (hôte, port 23, utilisateur,
#   clé, known_hosts : voir RUNBOOK-BACKUP.md, étape 5). Chemin relatif au
#   dossier du compte de la Storage Box.
RESTIC_REPOSITORY=sftp:alivaon-storagebox:restic-alivaon
#
# Option B — stockage objet compatible S3 (Hetzner Object Storage, etc.) :
#   RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/NOM_DU_BUCKET/restic-alivaon
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   Le bucket doit être PRIVÉ. Clés d'accès limitées à ce seul bucket.

# Fichier contenant le mot de passe du dépôt (root:root 0400).
#
# ╔═════════════════════════════════════════════════════════════════════════╗
# ║  POINT DE DÉFAILLANCE UNIQUE DU DISPOSITIF                              ║
# ║                                                                         ║
# ║  Ce mot de passe chiffre TOUT le dépôt. Il n'existe aucun moyen de le   ║
# ║  retrouver ni de le contourner : ni Hetzner, ni restic ne le peuvent.   ║
# ║                                                                         ║
# ║  Le fichier ci-dessous vit sur le VPS. Si le VPS est perdu, il est      ║
# ║  perdu avec lui. Une COPIE doit donc exister HORS du serveur, dans le   ║
# ║  gestionnaire de mots de passe, AVANT la première sauvegarde. Sans      ║
# ║  elle, les sauvegardes existent mais sont illisibles à jamais.          ║
# ╚═════════════════════════════════════════════════════════════════════════╝
RESTIC_PASSWORD_FILE=/etc/alivaon-backup/restic-password

# Nom d'hôte inscrit dans les instantanés. FIXE, et non le hostname réel :
# un VPS reconstruit portera un autre nom, et la rétention (groupée par hôte)
# ne doit pas repartir de zéro. Ne pas modifier après la première sauvegarde.
RESTIC_HOST=alivaon-vps

# Cache local de restic (index, métadonnées). Facultatif.
# RESTIC_CACHE_DIR=/var/cache/alivaon-backup


# ── Environnements sauvegardés ──────────────────────────────────────────────
#
# Traités dans cet ordre. Seules valeurs admises : production, staging.
BACKUP_ENVIRONMENTS='production staging'


# ── Production ──────────────────────────────────────────────────────────────
#
# Conteneur MySQL : nom confirmé par adminer/docker-compose.yml.
PRODUCTION_DB_CONTAINER=production-db-1
# Base et utilisateur applicatif : README racine, « Connexion à Adminer ».
PRODUCTION_DB_NAME=alivaon_db
PRODUCTION_DB_USER=alivaon_app
# = MYSQL_PASSWORD de /opt/alivaon/production/.env. Le recopier tel quel.
# S'il change un jour côté MySQL, le changer ICI aussi : sinon la sauvegarde
# échoue dès la nuit suivante (et l'alerte se déclenche).
# Transmis au conteneur par l'entrée standard, jamais en argument (ps).
PRODUCTION_DB_PASSWORD=

# Conteneur applicatif, arrêté pendant une restauration.
# Nom DÉDUIT (<projet>-<service>-1), à vérifier : docker ps
PRODUCTION_APP_CONTAINER=production-app-1

# Volumes de fichiers, sous la forme rôle=nom_du_volume_docker, séparés par
# des espaces. Le chemin sur disque n'est jamais écrit ici : il est demandé à
# Docker (docker volume inspect) à chaque exécution.
#   uploads    -> /var/www/html/public/uploads  (VichUploader)
#   cv_private -> /var/www/html/var/private     (CV des candidats, hors docroot)
# Noms confirmés par filebrowser/docker-compose.yml (production_uploads) et
# ses commentaires (production_cv_private).
# Le rôle sert à apparier les volumes lors d'une restauration : il doit être
# identique d'un environnement à l'autre.
PRODUCTION_VOLUMES='uploads=production_uploads cv_private=production_cv_private'


# ── Staging ─────────────────────────────────────────────────────────────────
STAGING_DB_CONTAINER=staging-db-1
STAGING_DB_NAME=alivaon_db
STAGING_DB_USER=alivaon_app
# = MYSQL_PASSWORD de /opt/alivaon/staging/.env
STAGING_DB_PASSWORD=
STAGING_APP_CONTAINER=staging-app-1
# Le suffixe « _staging » est doublé : projet « staging » + volume
# « uploads_staging » (confirmé par filebrowser/docker-compose.yml).
STAGING_VOLUMES='uploads=staging_uploads_staging cv_private=staging_cv_private_staging'


# ── Rétention ───────────────────────────────────────────────────────────────
#
# Appliquée séparément à chaque environnement, puis `restic forget --prune`.
# Ordre de grandeur : ~17 instantanés conservés par environnement, soit un
# historique de six mois.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6


# ── Surveillance ────────────────────────────────────────────────────────────
#
# Âge maximal toléré du dernier instantané, contrôlé par verify.sh.
MAX_AGE_HOURS=48

# Dead man's switch (healthchecks.io ou instance auto-hébergée compatible).
# URL de ping du check, sans suffixe, par exemple :
#   https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Reçoit /start au début, /0 en cas de succès, /<code> ou /fail en cas
# d'échec. Le service alerte aussi si AUCUN ping n'arrive dans le délai :
# c'est le seul moyen de détecter une sauvegarde qui ne s'exécute plus.
# VIDE = désactivé (le journal systemd reste alimenté).
HC_PING_URL=


# ── Exclusions (facultatif) ─────────────────────────────────────────────────
#
# Fichier de motifs restic (--exclude-file), un motif par ligne. Utile
# seulement si un cache régénérable (LiipImagine) se trouvait DANS un volume
# d'uploads : voir l'hypothèse H4 du RUNBOOK-BACKUP.md.
RESTIC_EXCLUDE_FILE=
