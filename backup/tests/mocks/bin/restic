#!/usr/bin/env bash
# Simulacre de restic pour tests/run.sh. Chaque appel est journalisé dans
# $TEST_ROOT/log/restic ; les réponses sont lues dans $TEST_ROOT/restic/.
set -euo pipefail
: "${TEST_ROOT:?variable posée par tests/run.sh}"
if [[ ${1:-} == --retry-lock ]]; then shift 2; fi
printf '%s\n' "$*" >>"$TEST_ROOT/log/restic"
case $1 in
  version) echo "restic 0.16.4 compiled with go1.22.2 on linux/amd64" ;;
  backup)
    for a in "$@"; do
      if [[ -f $a/manifest ]]; then cp "$a/manifest" "$TEST_ROOT/log/manifest"; fi
    done
    echo "snapshot 1a2b3c4d saved"
    ;;
  dump) cat "$TEST_ROOT/restic/dump" ;;
  ls)
    # Dernier argument : le chemin demandé ; réponse (JSON lines) dans
    # $TEST_ROOT/restic/ls.json.
    cat "$TEST_ROOT/restic/ls.json"
    ;;
  *) ;;
esac
