#!/usr/bin/env bash
# Simulacre de df pour tests/run.sh, format POSIX (df -Pk).
# Si $TEST_ROOT/df.conf existe, chaque ligne « PRÉFIXE MONTAGE DISPO_KO »
# déclare un système de fichiers : le premier dont PRÉFIXE commence le chemin
# demandé répond. Sinon, ou sans correspondance, délégation au vrai df.
set -euo pipefail
: "${TEST_ROOT:?variable posée par tests/run.sh}" "${TEST_MOCKS:?variable posée par tests/run.sh}"
path=${!#}
conf=$TEST_ROOT/df.conf
if [[ -f $conf ]]; then
  while read -r prefix mount kb; do
    [[ -z $prefix ]] && continue
    if [[ $path == "$prefix"* ]]; then
      echo "Filesystem 1024-blocks Used Available Capacity Mounted on"
      echo "simule 0 0 $kb 0% $mount"
      exit 0
    fi
  done <"$conf"
fi
IFS=: read -r -a dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  [[ $d == "$TEST_MOCKS/bin" || ! -x $d/df ]] && continue
  exec "$d/df" "$@"
done
exit 127
