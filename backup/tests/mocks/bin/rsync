#!/usr/bin/env bash
# Enveloppe de rsync pour tests/run.sh : consigne ses arguments dans
# $TEST_ROOT/log/rsync, simule un échec si MOCK_RSYNC_EXIT est posé, et sinon
# délègue au VRAI rsync (le premier du PATH hors des simulacres). Les modes
# --merge et --mirror sont donc éprouvés sur un rsync réel.
set -euo pipefail
: "${TEST_ROOT:?variable posée par tests/run.sh}" "${TEST_MOCKS:?variable posée par tests/run.sh}"
printf '%s\n' "$*" >>"$TEST_ROOT/log/rsync"
if [[ -n ${MOCK_RSYNC_EXIT:-} ]]; then
  echo "rsync: erreur simulée" >&2
  exit "$MOCK_RSYNC_EXIT"
fi
IFS=: read -r -a dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  [[ $d == "$TEST_MOCKS/bin" ]] && continue
  if [[ -x $d/rsync ]]; then exec "$d/rsync" "$@"; fi
done
echo "rsync introuvable hors des simulacres" >&2
exit 127
