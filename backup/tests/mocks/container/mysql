#!/usr/bin/env bash
# Simulacre du client mysql : consigne le fichier d'options et l'entrée reçue.
set -euo pipefail
: "${TEST_ROOT:?variable posée par tests/run.sh}"
cnf=${1#--defaults-extra-file=}
{ echo "ARGS: $*"; echo "CNF_PATH: $cnf"; cat "$cnf"; } >"$TEST_ROOT/log/mysql"
cat >"$TEST_ROOT/log/mysql.stdin"
# Échec simulé à la demande (import interrompu).
if [[ -n ${MOCK_MYSQL_EXIT:-} ]]; then
  echo "ERROR 1064 (42000) at line 42: erreur simulée" >&2
  exit "$MOCK_MYSQL_EXIT"
fi
