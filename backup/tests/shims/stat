#!/usr/bin/env bash
# Traduit `stat -c FORMAT [--] FICHIER...` (GNU) vers le stat BSD de macOS.
# %a (droits octaux) -> %Lp, %s (taille) -> %z, %n (nom) -> %N.
fmt=$2
shift 2
if [[ ${1:-} == -- ]]; then shift; fi
fmt=${fmt//%a/%Lp}
fmt=${fmt//%s/%z}
fmt=${fmt//%n/%N}
exec /usr/bin/stat -f "$fmt" "$@"
